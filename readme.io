         .contact {
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 15px;
  padding: 50px 20px;
  text-align: center;
  margin: 40px auto;
  max-width: 800px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
}

.contact h2 {
  color: #38bdf8;
  margin-bottom: 15px;
}

.contact p {
  color: #f8fafc;
  margin-bottom: 25px;
  font-size: 1rem;
}